<?xml version="1.0" encoding="utf-8"?>
<!-- Stage 52 unified command system (own file so parallel work on agent_strings.xml does not collide). English and German only. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- %1$s: the command prefix -->
    <string name="agent_command_guard">Format guard per app: %1$sguard banking off switches the hints of the format guard off in one app, %1$sguard banking on back on, %1$sguard all off everywhere (the switch on the settings page); %1$sguard list shows what is set. German: %1$swächter, an, aus.</string>
    <string name="agent_command_mem">Memory per app: %1$smem whatsapp off keeps the memory out of one app, %1$smem whatsapp on lets it learn there again, %1$smem list shows the apps it stays out of. German: %1$sgedächtnis, an, aus.</string>
    <string name="agent_command_group">Own groups of apps: %1$sgroup messenger whatsapp signal makes the group, after that %1$slang messenger german works for all of its apps; %1$sgroup messenger add telegram, del signal, %1$sgroup list. German: %1$sgruppe, neu, weg.</string>

