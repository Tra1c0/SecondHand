<?xml version="1.0" encoding="utf-8"?>
<!-- Stage 52 unified command system (own file so parallel work on agent_strings.xml does not collide). English and German only. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- %1$s: the command prefix -->
    <string name="agent_command_guard">Formatwächter je App: %1$sguard banking off schaltet die Hinweise des Formatwächters in einer App aus, %1$sguard banking on wieder an, %1$sguard all off überall (der Schalter in den Einstellungen); %1$sguard list zeigt, was festgelegt ist. Deutsch: %1$swächter, an, aus.</string>
    <string name="agent_command_mem">Gedächtnis je App: %1$smem whatsapp off hält das Gedächtnis aus einer App heraus, %1$smem whatsapp on lässt es dort wieder lernen, %1$smem list zeigt die ausgeschlossenen Apps. Deutsch: %1$sgedächtnis, an, aus.</string>
    <string name="agent_command_group">Eigene App-Gruppen: %1$sgroup messenger whatsapp signal legt die Gruppe an, danach gilt %1$slang messenger german für alle ihre Apps; %1$sgroup messenger add telegram, del signal, %1$sgroup list. Deutsch: %1$sgruppe, neu, weg.</string>

