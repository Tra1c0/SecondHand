<?xml version="1.0" encoding="utf-8"?>
<!-- Everything sits at the top so the keyboard never covers it. Each field has a "mirror" line that
     shows its real content (a password field shows only dots in a UI dump); the host script reads the
     mirrors, and they make the recording readable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/scenario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Three copy buttons with three different texts: the keyboard offers a copied text once, so a
         test that copies twice needs two texts. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copy_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="copy 1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/copy_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="copy 2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/copy_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="copy 3"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/field_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="text"
        android:importantForAutofill="no"
        android:inputType="text|textCapSentences|textAutoCorrect|textMultiLine"
        android:maxLines="2"
        android:textSize="15sp" />

    <!-- Stages 104/105: a one-line chat field that sends with Enter (no line break); shown only in the retro_send scenario -->
    <EditText
        android:id="@+id/field_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="chat"
        android:imeOptions="actionSend"
        android:importantForAutofill="no"
        android:inputType="text|textCapSentences|textAutoCorrect"
        android:visibility="gone"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/field_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/field_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="email"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/field_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="number"
        android:importantForAutofill="no"
        android:inputType="number"
        android:textSize="15sp" />

    <!-- Only for the autofill scenario (MainActivity shows them): a user name and a password field with
         autofill hints. Not important for autofill until then, so no other scenario sees them. -->
    <EditText
        android:id="@+id/field_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="username"
        android:hint="login"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:visibility="gone"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/field_secret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="password"
        android:hint="secret"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:visibility="gone"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/mirror_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/mirror_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/mirror_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/mirror_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/mirror_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/mirror_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mirror_secret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
