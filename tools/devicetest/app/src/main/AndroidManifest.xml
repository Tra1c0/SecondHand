<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="SH Device Test"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lists the nodes of all windows for the host script. While it is enabled,
             AccessibilityManager.isEnabled() is true, and only then the keyboard exposes its keys as
             accessibility nodes (MainKeyboardView.setKeyboard). It does not request touch exploration. -->
        <service
            android:name=".ProbeAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe_accessibility" />
        </service>

        <!-- Fake autofill service of the inline-suggestion scenario (stage 73c). Not selected unless
             devicetest.py sets it for that scenario. -->
        <service
            android:name=".FakeAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- "adb shell content read" on this provider returns the node list of the probe service. -->
        <provider
            android:name=".DumpProvider"
            android:authorities="dev.personal.secondhand.devicetest.dump"
            android:exported="true" />
    </application>
</manifest>
